---
interface Props {
  current: 'a' | 'b' | 'c';
}

const { current } = Astro.props;

const directions = [
  { id: 'a', label: 'A', name: 'Editorial' },
  { id: 'b', label: 'B', name: 'Swiss' },
  { id: 'c', label: 'C', name: 'Technical' },
] as const;
---

<div class="jp-switcher" data-jp-switcher>
  <nav class="jp-switcher__bar" aria-label="Design direction">
    <a class="jp-switcher__home" href="/design">
      <span aria-hidden="true">&#8592;</span> All directions
    </a>
    <span class="jp-switcher__divider" aria-hidden="true"></span>
    <ul class="jp-switcher__list">
      {
        directions.map((d) => (
          <li>
            <a
              href={`/design/${d.id}`}
              class="jp-switcher__link"
              aria-current={d.id === current ? 'page' : undefined}
            >
              <span class="jp-switcher__letter">{d.label}</span>
              <span class="jp-switcher__name">{d.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .jp-switcher {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 90;
    pointer-events: none;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
  }

  .jp-switcher__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.375rem 0.3125rem 0.75rem;
    border-radius: 999px;
    background: rgba(16, 17, 19, 0.92);
    backdrop-filter: blur(10px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 12px 32px -8px rgba(0, 0, 0, 0.5);
    font-family:
      'Inter Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    line-height: 1;
    color: #f4f4f5;
    --focus-ring: #ffffff;
    --focus-ring-offset: 2px;
  }

  .jp-switcher__home {
    color: #b8bbc0;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    padding: 0.4rem 0.125rem;
    border-radius: 4px;
  }

  .jp-switcher__home:hover {
    color: #ffffff;
  }

  .jp-switcher__divider {
    width: 1px;
    align-self: stretch;
    background: rgba(255, 255, 255, 0.16);
    margin-inline: 0.125rem;
  }

  .jp-switcher__list {
    display: flex;
    align-items: center;
    gap: 0.1875rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .jp-switcher__link {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.4375rem 0.6875rem;
    border-radius: 999px;
    color: #b8bbc0;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .jp-switcher__link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .jp-switcher__link[aria-current='page'] {
    background: #ffffff;
    color: #101113;
    font-weight: 600;
  }

  .jp-switcher__letter {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  @media (max-width: 30rem) {
    .jp-switcher__home span:last-child,
    .jp-switcher__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .jp-switcher__bar {
      padding-left: 0.625rem;
    }
  }

  /* Hidden inside the comparison iframes on /design. */
  :global(html[data-embedded='true']) .jp-switcher {
    display: none;
  }
</style>

<script is:inline>
  if (window.self !== window.top) {
    document.documentElement.setAttribute('data-embedded', 'true');
  }
</script>
