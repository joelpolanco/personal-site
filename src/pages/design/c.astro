---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectionSwitcher from '../../components/DirectionSwitcher.astro';
import '../../styles/direction-c.css';
import {
  background,
  currentRole,
  footer,
  hero,
  nav,
  site,
  skills,
  testimonial,
} from '../../content/home';

const specs = [
  { key: 'role', value: 'Senior Product Manager' },
  { key: 'company', value: 'Intel' },
  { key: 'org', value: 'Edge Computing Group' },
  { key: 'portfolio', value: 'Retail point-of-sale' },
  { key: 'advising', value: 'Pre-seed battery startup' },
  { key: 'coaching', value: 'Customer discovery for future founders' },
  { key: 'background', value: 'Semiconductor fab process engineer, MBA' },
];

const interests = [
  'personal finance',
  'investing',
  'reading',
  'writing',
  'advising future founders',
];
---

<BaseLayout
  title={`${site.name} — Technical (Direction C)`}
  description="Design direction C: a technical treatment of Joel Polanco's homepage — monospace accents, dark-first with a light toggle, dense information blocks."
  direction="technical"
  bodyClass="tc"
  colorScheme="light dark"
  themeColor="#0b0d0f"
  noindex
>
  <script slot="head" is:inline>
    (function () {
      var stored = null;
      try {
        stored = localStorage.getItem('jp-design-c-scheme');
      } catch (e) {
        /* storage blocked; fall back to the dark default */
      }
      var scheme = stored === 'light' || stored === 'dark' ? stored : 'dark';
      document.documentElement.setAttribute('data-scheme', scheme);
      document.documentElement.style.colorScheme = scheme;
    })();
  </script>

  <a class="skip-link" href="#main">Skip to content</a>

  <div class="tc-statusbar">
    <div class="tc-shell tc-statusbar__inner">
      <span>
        <span class="tc-statusbar__dot" aria-hidden="true"></span>
        Senior Product Manager
      </span>
      <span class="tc-statusbar__sep" aria-hidden="true">/</span>
      <span>Intel &middot; Edge Computing Group</span>
      <span class="tc-statusbar__sep" aria-hidden="true">/</span>
      <span>Retail point-of-sale</span>
    </div>
  </div>

  <header class="tc-header">
    <div class="tc-shell tc-header__inner">
      <a class="tc-wordmark" href="/design/c">joel<span>.</span>polanco</a>
      <div class="tc-headnav">
        <nav aria-label="Primary">
          <ul class="tc-nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>
                    {item.label.toLowerCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="tc-toggle" type="button" data-scheme-toggle aria-pressed="false">
          <svg
            class="tc-toggle__icon tc-toggle__moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="tc-toggle__icon tc-toggle__sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <span class="tc-toggle__label-dark">dark</span>
          <span class="tc-toggle__label-light">light</span>
          <span class="sr-only">Toggle color scheme</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="tc-hero">
      <div class="tc-shell tc-hero__grid">
        <div>
          <p class="tc-eyebrow">
            <span class="tc-eyebrow__bracket">[</span>
            {hero.greeting}
            <span class="tc-eyebrow__bracket">]</span>
          </p>
          <h1 class="tc-hero__name">
            {hero.name}<span class="tc-hero__cursor" aria-hidden="true"></span>
          </h1>

          <p class="tc-lede">
            {
              hero.intro.map((run) =>
                run.emphasis ? <span class="tc-em">{run.text}</span> : <>{run.text}</>,
              )
            }
          </p>

          <p class="tc-lede">
            {
              hero.now.map((run) =>
                run.emphasis ? (
                  run.href ? (
                    <a class="tc-em" href={run.href}>
                      {run.text}
                    </a>
                  ) : (
                    <span class="tc-em">{run.text}</span>
                  )
                ) : (
                  <>{run.text}</>
                ),
              )
            }
          </p>

          <div class="tc-actions">
            <a class="tc-btn" href={hero.cta.href}>
              {hero.cta.label}
              <span aria-hidden="true">&#8594;</span>
            </a>
            <a class="tc-btn tc-btn--ghost" href={currentRole.cta.href} rel="me noopener">
              {currentRole.cta.label}
              <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </div>

        <div class="tc-panel">
          <div class="tc-panel__head">
            <span>~/profile.json</span>
            <span aria-hidden="true">&#9679;&#9679;&#9679;</span>
          </div>
          <dl class="tc-specs">
            {
              specs.map((spec) => (
                <>
                  <dt>{spec.key}</dt>
                  <dd>{spec.value}</dd>
                </>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <div class="tc-shell">
      <section class="tc-section">
        <div class="tc-section__head">
          <span class="tc-section__num">01</span>
          <h2 class="tc-section__title">{background.heading}</h2>
          <span class="tc-section__note">engineer &#8594; analyst &#8594; product</span>
        </div>
        <div class="tc-cols">
          <div class="tc-body">
            <p>
              {
                background.body[0].map((run) =>
                  run.emphasis ? <strong>{run.text}</strong> : <>{run.text}</>,
                )
              }
            </p>
          </div>
          <div class="tc-body">
            <p>
              {
                background.body[1].map((run) =>
                  run.emphasis ? <strong>{run.text}</strong> : <>{run.text}</>,
                )
              }
            </p>
          </div>
        </div>
      </section>

      <section class="tc-section">
        <div class="tc-section__head">
          <span class="tc-section__num">02</span>
          <h2 class="tc-section__title">{currentRole.heading}</h2>
          <span class="tc-section__note">{currentRole.title}</span>
        </div>
        <div class="tc-cols">
          <div class="tc-body">
            <p>{currentRole.body[0]}</p>
          </div>
          <div>
            <p class="tc-eyebrow tc-aside__label">Other interests</p>
            <ul class="tc-chips">
              {interests.map((interest) => <li class="tc-chip">{interest}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="tc-section">
        <div class="tc-section__head">
          <span class="tc-section__num">03</span>
          <h2 class="tc-section__title">{skills.heading}</h2>
          <span class="tc-section__note">4 areas</span>
        </div>
        <div class="tc-table">
          {
            skills.items.map((skill) => (
              <div class="tc-row">
                <span class="tc-row__num" aria-hidden="true">
                  {skill.number}
                </span>
                <h3 class="tc-row__title">{skill.title.replace(/\.$/, '')}</h3>
                <p class="tc-row__detail">
                  <strong>{skill.lead}</strong>
                  {skill.rest}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="tc-section">
        <div class="tc-section__head">
          <span class="tc-section__num">04</span>
          <h2 class="tc-section__title">What people say</h2>
          <span class="tc-section__note">customer discovery engagement</span>
        </div>
        <figure class="tc-quote">
          <p class="tc-quote__flag">// {testimonial.company.toLowerCase()}</p>
          <blockquote class="tc-quote__text">{testimonial.quote}</blockquote>
          <figcaption class="tc-quote__cite">
            <strong>{testimonial.author}</strong>
            <span>
              {testimonial.role}, {testimonial.company}
            </span>
          </figcaption>
        </figure>
      </section>
    </div>
  </main>

  <footer class="tc-footer">
    <div class="tc-shell">
      <div class="tc-footer__grid">
        <nav aria-label="Footer">
          <ul class="tc-footer__nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label.toLowerCase()}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="tc-mono tc-footer__connect">
          {footer.connect}
          <a href={site.linkedin} rel="me noopener">LinkedIn &#8599;</a>
        </p>
      </div>
      <p class="tc-footer__meta">{site.copyright}</p>
    </div>
  </footer>

  <DirectionSwitcher current="c" />
</BaseLayout>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-scheme-toggle]');

  function apply(scheme: 'light' | 'dark') {
    root.setAttribute('data-scheme', scheme);
    root.style.colorScheme = scheme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', scheme === 'dark' ? '#0b0d0f' : '#fafaf9');
    toggle?.setAttribute('aria-pressed', String(scheme === 'light'));
  }

  apply(root.getAttribute('data-scheme') === 'light' ? 'light' : 'dark');

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-scheme') === 'light' ? 'dark' : 'light';
    apply(next);
    try {
      localStorage.setItem('jp-design-c-scheme', next);
    } catch {
      /* storage blocked; the choice just will not persist */
    }
  });
</script>
