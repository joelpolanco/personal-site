---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectionSwitcher from '../../components/DirectionSwitcher.astro';
import '../../styles/direction-a.css';
import {
  background,
  currentRole,
  footer,
  hero,
  nav,
  site,
  skills,
  testimonial,
} from '../../content/home';
---

<BaseLayout
  title={`${site.name} — Editorial (Direction A)`}
  description="Design direction A: an editorial treatment of Joel Polanco's homepage — serif display type, warm paper, a single ink accent."
  direction="editorial"
  bodyClass="ed"
  themeColor="#fbf8f2"
  noindex
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="ed-header">
    <div class="ed-shell ed-header__inner">
      <a class="ed-wordmark" href="/design/a">Joel Polanco</a>
      <nav aria-label="Primary">
        <ul class="ed-nav">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="ed-shell ed-hero">
      <p class="ed-hero__greeting">{hero.greeting}</p>
      <h1 class="ed-hero__name">{hero.name}</h1>

      <p class="ed-lede">
        {
          hero.intro.map((run) =>
            run.emphasis ? <em class="ed-em">{run.text}</em> : <>{run.text}</>,
          )
        }
      </p>

      <p class="ed-lede">
        {
          hero.now.map((run) =>
            run.emphasis ? (
              run.href ? (
                <a class="ed-em" href={run.href}>
                  {run.text}
                </a>
              ) : (
                <em class="ed-em">{run.text}</em>
              )
            ) : (
              <>{run.text}</>
            ),
          )
        }
      </p>

      <a class="ed-cta" href={hero.cta.href}>
        {hero.cta.label}
        <span class="ed-cta__arrow" aria-hidden="true">&#8594;</span>
      </a>
    </section>

    <div class="ed-shell">
      <section class="ed-section">
        <h2 class="ed-heading">
          <span class="ed-heading__eyebrow">{background.eyebrow}</span>
          {background.heading}
        </h2>
        <div class="ed-prose ed-prose--dropcap">
          {
            background.body.map((paragraph) => (
              <p>
                {paragraph.map((run) =>
                  run.emphasis ? <em class="ed-em">{run.text}</em> : <>{run.text}</>,
                )}
              </p>
            ))
          }
        </div>
      </section>

      <section class="ed-section">
        <h2 class="ed-heading">
          <span class="ed-heading__eyebrow">{currentRole.eyebrow}</span>
          {currentRole.heading}
        </h2>
        <p class="ed-role">
          <span class="ed-role__org">Intel &middot; Edge Computing Group</span>
          {currentRole.title}
        </p>
        <div class="ed-prose">
          {currentRole.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="ed-link" href={currentRole.cta.href} rel="me noopener">
          {currentRole.cta.label}
          <span aria-hidden="true">&#8599;</span>
        </a>
      </section>

      <section class="ed-section">
        <h2 class="ed-heading">
          <span class="ed-heading__eyebrow">{skills.eyebrow}</span>
          {skills.heading}
        </h2>
        <ol class="ed-skills">
          {
            skills.items.map((skill) => (
              <li class="ed-skill">
                <span class="ed-skill__number" aria-hidden="true">
                  {skill.number}
                </span>
                <div>
                  <h3 class="ed-skill__title">{skill.title}</h3>
                  <p class="ed-skill__detail">
                    <strong>{skill.lead}</strong>
                    {skill.rest}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <figure class="ed-quote">
      <div class="ed-shell">
        <span class="ed-quote__mark" aria-hidden="true">&ldquo;</span>
        <blockquote class="ed-quote__text">{testimonial.quote}</blockquote>
        <figcaption class="ed-quote__cite">
          <strong>{testimonial.author}</strong>, {testimonial.role}, {testimonial.company}
        </figcaption>
      </div>
    </figure>
  </main>

  <footer class="ed-footer">
    <div class="ed-shell">
      <div class="ed-footer__grid">
        <nav aria-label="Footer">
          <ul class="ed-nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <p class="ed-footer__connect">{footer.connect}</p>
          <a class="ed-footer__social" href={site.linkedin} rel="me noopener">LinkedIn</a>
        </div>
      </div>
      <p class="ed-footer__meta">{site.copyright}</p>
    </div>
  </footer>

  <DirectionSwitcher current="a" />
</BaseLayout>
