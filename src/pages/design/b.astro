---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectionSwitcher from '../../components/DirectionSwitcher.astro';
import '../../styles/direction-b.css';
import {
  background,
  currentRole,
  footer,
  hero,
  nav,
  site,
  skills,
  testimonial,
} from '../../content/home';

const facts = [
  { key: 'Role', value: 'Senior Product Manager' },
  { key: 'Org', value: 'Intel, Edge Computing Group' },
  { key: 'Focus', value: 'Retail point-of-sale' },
  { key: 'Also', value: 'Pre-seed battery startup advisor' },
  { key: 'Coaching', value: 'Customer discovery for founders' },
];
---

<BaseLayout
  title={`${site.name} — Swiss grid (Direction B)`}
  description="Design direction B: a Swiss-grid treatment of Joel Polanco's homepage — tight sans, hairline rules, numbered sections, one saturated accent."
  direction="swiss"
  bodyClass="sw"
  themeColor="#ffffff"
  noindex
>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="sw-guides" aria-hidden="true">
    <div class="sw-guides__inner">
      {Array.from({ length: 12 }).map(() => <div class="sw-guides__col"></div>)}
    </div>
  </div>

  <header class="sw-header">
    <div class="sw-shell sw-header__inner">
      <a class="sw-wordmark" href="/design/b">
        <span class="sw-wordmark__dot" aria-hidden="true"></span>
        Joel Polanco
      </a>
      <nav aria-label="Primary">
        <ul class="sw-nav">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="sw-layer">
    <section class="sw-hero">
      <div class="sw-shell sw-grid">
        <div class="sw-c1-8">
          <p class="sw-label">
            <span class="sw-label__num">00</span>
            <span>Product management &middot; Intel Edge Computing Group</span>
          </p>
          <h1 class="sw-hero__title">
            <span class="sw-hero__greeting">{hero.greeting}</span>
            {hero.name}
          </h1>

          <p class="sw-lede">
            {
              hero.intro.map((run) =>
                run.emphasis ? <span class="sw-em">{run.text}</span> : <>{run.text}</>,
              )
            }
          </p>

          <p class="sw-lede">
            {
              hero.now.map((run) =>
                run.emphasis ? (
                  run.href ? (
                    <a class="sw-em" href={run.href}>
                      {run.text}
                    </a>
                  ) : (
                    <span class="sw-em">{run.text}</span>
                  )
                ) : (
                  <>{run.text}</>
                ),
              )
            }
          </p>

          <a class="sw-btn" href={hero.cta.href}>
            {hero.cta.label}
            <span class="sw-btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>

        <div class="sw-c10-3">
          <ul class="sw-facts">
            {
              facts.map((fact) => (
                <li>
                  <span class="sw-facts__key">{fact.key}</span>
                  <span class="sw-facts__val">{fact.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="sw-section">
      <div class="sw-shell sw-grid">
        <div class="sw-c1-3 sw-section__head">
          <span class="sw-section__num">01</span>
          <h2 class="sw-section__title">
            {background.heading}
            <span>Semiconductors to product</span>
          </h2>
        </div>
        <div class="sw-c5-8 sw-body">
          {
            background.body.map((paragraph) => (
              <p>
                {paragraph.map((run) =>
                  run.emphasis ? <strong>{run.text}</strong> : <>{run.text}</>,
                )}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sw-section">
      <div class="sw-shell sw-grid">
        <div class="sw-c1-3 sw-section__head">
          <span class="sw-section__num">02</span>
          <h2 class="sw-section__title">
            {currentRole.heading}
            <span>Intel, Edge Computing Group</span>
          </h2>
        </div>
        <div class="sw-c5-8">
          <div class="sw-role">
            <h3 class="sw-role__title">{currentRole.title}</h3>
            <span class="sw-tag">Retail point-of-sale</span>
          </div>
          <div class="sw-body">
            {currentRole.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a class="sw-textlink" href={currentRole.cta.href} rel="me noopener">
            {currentRole.cta.label}
            <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="sw-section">
      <div class="sw-shell">
        <div class="sw-grid sw-skills-head">
          <div class="sw-c1-3">
            <span class="sw-section__num">03</span>
            <h2 class="sw-section__title">
              {skills.heading}
              <span>What I am hired for</span>
            </h2>
          </div>
        </div>
        <ol class="sw-skills">
          {
            skills.items.map((skill) => (
              <li class="sw-skill">
                <span class="sw-skill__num" aria-hidden="true">
                  {skill.number}
                </span>
                <h3 class="sw-skill__title">{skill.title}</h3>
                <p class="sw-skill__detail">
                  <strong>{skill.lead}</strong>
                  {skill.rest}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <figure class="sw-quote">
      <div class="sw-shell sw-grid">
        <div class="sw-c1-8">
          <span class="sw-section__num sw-quote__num">04</span>
          <blockquote class="sw-quote__text">{testimonial.quote}</blockquote>
        </div>
        <figcaption class="sw-c10-3 sw-quote__cite">
          <strong>{testimonial.author}</strong>
          {testimonial.role}, {testimonial.company}
        </figcaption>
      </div>
    </figure>
  </main>

  <footer class="sw-footer sw-layer">
    <div class="sw-shell sw-grid">
      <div class="sw-c1-4">
        <p class="sw-footer__brand">Joel Polanco</p>
        <p class="sw-footer__meta">{site.copyright}</p>
      </div>
      <nav class="sw-c5-8 sw-footer__col" aria-label="Footer">
        <h2>Pages</h2>
        <ul class="sw-footer__list sw-footer__list--inline">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
        <h2>{footer.connect}</h2>
        <ul class="sw-footer__list">
          <li><a href={site.linkedin} rel="me noopener">LinkedIn &#8599;</a></li>
        </ul>
      </nav>
    </div>
  </footer>

  <DirectionSwitcher current="b" />
</BaseLayout>
