---
import BaseLayout from '../../layouts/BaseLayout.astro';

const directions = [
  {
    id: 'a',
    letter: 'A',
    name: 'Editorial',
    summary:
      'Large serif display type on a warm paper tone with a single ink accent and a wide reading measure. Reads like a respected essayist.',
    traits: ['Fraunces + Source Serif', 'Warm off-white paper', 'Terracotta ink accent'],
    bestFor: 'Leads with the writing. Best if the blog is the centre of gravity.',
    swatches: ['#fbf8f2', '#1c1a17', '#9c3b1e'],
  },
  {
    id: 'b',
    letter: 'B',
    name: 'Swiss grid',
    summary:
      'Tight sans type on a visible 12-column grid, hairline rules, and numbered sections that echo the existing 01\u201304 skills. Monochrome plus one saturated accent.',
    traits: ['Inter, tight tracking', 'Visible column guides', 'Saturated red accent'],
    bestFor: 'Leads with craft and structure. Best if the portfolio does the selling.',
    swatches: ['#ffffff', '#101010', '#e5230c'],
  },
  {
    id: 'c',
    letter: 'C',
    name: 'Technical',
    summary:
      'Monospace accents, dark-first with a light toggle, and denser information blocks. Signals the engineer-turned-PM background immediately.',
    traits: ['JetBrains Mono + Inter', 'Dark-first, light toggle', 'Terminal green accent'],
    bestFor: 'Leads with credibility. Best if the audience is engineers and technical founders.',
    swatches: ['#0b0d0f', '#e7eaed', '#4ade80'],
  },
] as const;
---

<BaseLayout
  title="Three design directions — joelpolanco.me"
  description="Compare three homepage design directions for joelpolanco.me, each built on the real homepage content."
  bodyClass="bg-neutral-50 font-sans text-neutral-900 antialiased"
  themeColor="#fafafa"
  noindex
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="border-b border-neutral-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-4 sm:px-8">
      <p class="text-sm font-semibold tracking-tight">joelpolanco.me</p>
      <p class="text-sm text-neutral-500">Design review &middot; pick one direction</p>
    </div>
  </header>

  <main id="main" class="mx-auto max-w-6xl px-5 pb-28 sm:px-8">
    <section class="border-b border-neutral-200 py-12 sm:py-16">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500">
        Step 2 of the migration
      </p>
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
        Three homepage directions, built on your real content.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg">
        Every direction below renders the same words from joelpolanco.me &mdash; your intro, My
        Background, My Current Role, the four numbered skills, and the Tastee Tape testimonial. The
        only thing changing is the design, so what you are judging is design, not copy.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-600">
        Open each one, resize your window, and pick a letter. The winner becomes the design system
        for all six pages and the 23 blog posts.
      </p>
    </section>

    <section class="py-10 sm:py-12">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500">
          Live previews
        </h2>
        <div
          class="inline-flex rounded-full border border-neutral-300 bg-white p-0.5 text-sm"
          role="group"
          aria-label="Preview viewport"
        >
          <button
            type="button"
            data-viewport="desktop"
            aria-pressed="true"
            class="vp-btn rounded-full px-3.5 py-1.5 font-medium text-neutral-600 transition"
          >
            Desktop
          </button>
          <button
            type="button"
            data-viewport="mobile"
            aria-pressed="false"
            class="vp-btn rounded-full px-3.5 py-1.5 font-medium text-neutral-600 transition"
          >
            Mobile
          </button>
        </div>
      </div>

      <ul class="grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-6">
        {
          directions.map((d) => (
            <li class="flex flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
              <div
                class="preview relative overflow-hidden border-b border-neutral-200 bg-neutral-100"
                data-preview
              >
                <iframe
                  src={`/design/${d.id}`}
                  title={`Preview of direction ${d.letter}: ${d.name}`}
                  loading="lazy"
                  tabindex="-1"
                  class="preview__frame origin-top-left border-0"
                />
                <a
                  href={`/design/${d.id}`}
                  class="absolute inset-0 z-10 block focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-neutral-900"
                >
                  <span class="sr-only">Open direction {d.letter}, {d.name}</span>
                </a>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center gap-2.5">
                  <span class="flex size-7 items-center justify-center rounded-md bg-neutral-900 text-sm font-bold text-white">
                    {d.letter}
                  </span>
                  <h3 class="text-lg font-semibold tracking-tight">{d.name}</h3>
                  <span class="ml-auto flex gap-1" aria-hidden="true">
                    {d.swatches.map((hex) => (
                      <span
                        class="size-4 rounded-full ring-1 ring-inset ring-black/15"
                        style={`background:${hex}`}
                      />
                    ))}
                  </span>
                </div>

                <p class="mt-3 text-sm leading-relaxed text-neutral-600">{d.summary}</p>

                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {d.traits.map((trait) => (
                    <li class="rounded-full border border-neutral-200 bg-neutral-50 px-2.5 py-1 text-xs text-neutral-600">
                      {trait}
                    </li>
                  ))}
                </ul>

                <p class="mt-4 border-t border-neutral-200 pt-4 text-sm leading-relaxed text-neutral-500">
                  {d.bestFor}
                </p>

                <a
                  href={`/design/${d.id}`}
                  class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
                >
                  Open direction {d.letter}
                  <span aria-hidden="true">&#8594;</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="rounded-xl border border-neutral-200 bg-white p-6 sm:p-8">
      <h2 class="text-lg font-semibold tracking-tight">How to give me your answer</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600">
        Reply with a single letter. If you want a hybrid &mdash; say, B&rsquo;s grid with
        A&rsquo;s serif headings &mdash; say that instead; each direction keeps its design tokens in
        its own scoped block, so mixing them is a contained change rather than a rebuild.
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600">
        These three routes are review-only and are excluded from the sitemap. They come out of the
        site once a direction is chosen.
      </p>
    </section>
  </main>

  <style>
    .preview {
      /* Scaled by script to fit the card while the iframe renders at a real viewport width. */
      height: 340px;
    }

    .preview__frame {
      width: var(--vp-width, 1440px);
      height: var(--vp-height, 1500px);
      transform: scale(var(--vp-scale, 0.25));
    }

    .vp-btn[aria-pressed='true'] {
      background: #171717;
      color: #ffffff;
    }
  </style>

  <script>
    const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-preview]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-viewport]'));

    const VIEWPORTS = {
      desktop: { width: 1440, height: 1500, cardHeight: 340 },
      mobile: { width: 390, height: 1400, cardHeight: 420 },
    } as const;

    let mode: keyof typeof VIEWPORTS = 'desktop';

    function layout() {
      const vp = VIEWPORTS[mode];
      for (const preview of previews) {
        const frame = preview.querySelector<HTMLIFrameElement>('iframe');
        if (!frame) continue;

        const available = preview.clientWidth;
        // Mobile frames are narrower than the card, so centre them instead of upscaling.
        const scale = mode === 'mobile' ? Math.min(1, available / vp.width) : available / vp.width;

        preview.style.height = `${vp.cardHeight}px`;
        frame.style.setProperty('--vp-width', `${vp.width}px`);
        frame.style.setProperty('--vp-height', `${vp.height}px`);
        frame.style.setProperty('--vp-scale', String(scale));
        frame.style.marginLeft = mode === 'mobile' ? `${Math.max(0, (available - vp.width * scale) / 2)}px` : '0px';
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        mode = button.dataset.viewport === 'mobile' ? 'mobile' : 'desktop';
        for (const b of buttons) {
          b.setAttribute('aria-pressed', String(b.dataset.viewport === mode));
        }
        layout();
      });
    }

    layout();
    window.addEventListener('resize', layout);
    window.addEventListener('load', layout);
  </script>
</BaseLayout>
