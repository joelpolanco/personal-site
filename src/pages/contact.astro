---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { person } from '../config/site';
import portrait from '../assets/joel-polanco-headshot.jpg';

const contact = await getEntry('contact', 'contact');
if (!contact) throw new Error('src/content/pages/contact.json is missing');
const { blocks } = contact.data;

const linkedInUrl =
  person.sameAs.find((url) => url.includes('linkedin.com')) ??
  'https://www.linkedin.com/in/jpolanco';

/**
 * Joel's five reasons came out of Wix as one numbered blob in a single string.
 * Split back into list items so they read as a list.
 */
const reasons = (blocks[0]?.body[0] ?? '')
  .split(/\n+/)
  .map((line) => line.replace(/^\d+\.\s*/, '').trim())
  .filter(Boolean);
---

<BaseLayout
  title="Contact"
  description={contact.data.description}
  canonical="https://joelpolanco.me/contact"
>
  <PageHead
    number="05"
    title="Let's talk"
    lede="The fastest way to reach me is a LinkedIn message."
  >
    <Fragment slot="eyebrow">Get in touch</Fragment>
  </PageHead>

  <section class="sw-section sw-section--flush">
    <div class="sw-shell sw-grid">
      <div class="sw-c1-3 sw-section__head">
        <span class="sw-section__num">01</span>
        <h2 class="sw-section__title">
          {blocks[0]?.heading ?? 'How can I help?'}
          <span>Five good reasons</span>
        </h2>
        <ol class="sw-reasons">
          {reasons.map((reason) => <li>{reason}</li>)}
        </ol>
      </div>

      <div class="sw-c5-8 sw-contact-aside">
        <Image
          src={portrait}
          alt="Joel Polanco in a dark suit"
          width={720}
          height={720}
          widths={[240, 480, 720]}
          sizes="15rem"
          class="sw-contact-portrait"
          loading="eager"
        />
        <a
          class="sw-btn"
          href={linkedInUrl}
          rel="me noopener noreferrer"
          target="_blank"
        >
          Message me on LinkedIn
          <span class="sw-btn__arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sw-contact-aside {
    display: grid;
    grid-template-columns: min-content;
    grid-template-rows: max-content max-content;
    align-content: start;
    align-self: center;
    justify-items: stretch;
    justify-self: start;
    gap: 1.5rem;
    max-width: 100%;
  }

  .sw-contact-aside .sw-btn {
    white-space: nowrap;
  }

  .sw-contact-portrait {
    display: block;
    width: 100%;
    min-width: 0;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--fg);
  }

  .sw-reasons {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: reason;
    border-top: 1px solid var(--hairline);
  }

  .sw-reasons li {
    counter-increment: reason;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.5rem;
    padding-block: 0.6875rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--fg-soft);
  }

  .sw-reasons li::before {
    content: '0' counter(reason);
    color: var(--accent-ink);
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    padding-top: 0.2rem;
  }
</style>
