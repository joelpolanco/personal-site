---
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonJsonLd from '../components/seo/PersonJsonLd.astro';
import PostCard from '../components/PostCard.astro';
import { renderInline } from '../lib/inline-markdown';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/pages/home.json is missing');
const { hero, partners, sections, skills, testimonials, writing } = home.data;

const posts = await getCollection('posts', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recent = posts.slice(0, 3);

const [background, currentRole] = sections;

/**
 * Structured data wants a URL, and handing it `local.src` would publish the
 * 3199px original — and make the build emit it. A 512px square is plenty.
 */
const portraitForSchema = hero.image.local
  ? await getImage({ src: hero.image.local, width: 512, height: 512, format: 'jpg' })
  : null;
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <PersonJsonLd slot="head" image={portraitForSchema?.src} />

  <section class="sw-section sw-section--flush" style="padding-bottom: clamp(2.5rem, 6vw, 4.5rem)">
    <div class="sw-shell sw-grid">
      <div class="sw-c1-8">
        <h1 class="sw-display">
          <span class="sw-display__greeting">{hero.greeting} </span>{hero.name}
        </h1>

        {
          hero.body.map((paragraph) => (
            <p class="sw-lede" set:html={renderInline(paragraph)} />
          ))
        }

        <p style="margin-top: clamp(1.75rem, 3.5vw, 2.5rem)">
          <a class="sw-btn" href={hero.cta.href}>
            {hero.cta.label}
            <span class="sw-btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>

      <div class="sw-c10-3">
        {
          hero.image.local && (
            <Image
              src={hero.image.local}
              alt={hero.image.alt ?? hero.name}
              width={720}
              height={720}
              widths={[240, 480, 720]}
              sizes="(max-width: 64rem) 12rem, 20vw"
              class="sw-portrait"
              loading="eager"
            />
          )
        }
        <ul class="sw-facts">
          {
            hero.facts.map((fact) => (
              <li>
                <span class="sw-facts__key">{fact.key}</span>
                <span class="sw-facts__val">{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sw-partners" aria-label={partners.heading}>
    <div class="sw-shell sw-partners__inner">
      <p class="sw-partners__label">{partners.heading}</p>
      {
        partners.items.map(
          (partner) =>
            partner.image.local && (
              <Image
                class="sw-partners__logo"
                src={partner.image.local}
                alt={partner.title}
                width={128}
                height={128}
                widths={[64, 128]}
                sizes="4rem"
                loading="lazy"
              />
            ),
        )
      }
    </div>
  </section>

  <section class="sw-section" aria-labelledby="background-heading">
    <div class="sw-shell sw-grid">
      <div class="sw-c1-3 sw-section__head">
        <span class="sw-section__num">{background.number}</span>
        <h2 class="sw-section__title" id="background-heading">
          {background.heading}
          <span>{background.kicker}</span>
        </h2>
      </div>
      <div class="sw-c4-6 sw-body">
        {background.body.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
      </div>
      {
        background.image?.local && (
          <figure class="sw-c10-3 sw-figure">
            <Image
              src={background.image.local}
              alt={background.image.alt ?? ''}
              width={480}
              height={476}
              widths={[240, 480]}
              sizes="(max-width: 64rem) 60vw, 20vw"
              loading="lazy"
            />
            <figcaption>{background.image.alt}</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <section class="sw-section" aria-labelledby="role-heading">
    <div class="sw-shell sw-grid">
      <div class="sw-c1-3 sw-section__head">
        <span class="sw-section__num">{currentRole.number}</span>
        <h2 class="sw-section__title" id="role-heading">
          {currentRole.heading}
          <span>{currentRole.kicker}</span>
        </h2>
      </div>
      <div class="sw-c5-8">
        <div class="sw-role">
          <h3 class="sw-role__title">{currentRole.roleTitle}</h3>
          {currentRole.roleTag && <span class="sw-tag">{currentRole.roleTag}</span>}
        </div>
        <div class="sw-body">
          {currentRole.body.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
        </div>
        {
          currentRole.cta && (
            <a
              class="sw-textlink sw-textlink--block"
              href={currentRole.cta.href}
              rel="me noopener noreferrer"
              target="_blank"
            >
              {currentRole.cta.label}
              <span aria-hidden="true">&#8599;</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="sw-section" aria-labelledby="skills-heading">
    <div class="sw-shell">
      <div class="sw-grid">
        <div class="sw-c1-3">
          <span class="sw-section__num">{skills.number}</span>
          <h2 class="sw-section__title" id="skills-heading">{skills.heading}</h2>
        </div>
      </div>
      <ol class="sw-skills">
        {
          skills.items.map((skill) => (
            <li class="sw-skill">
              <span class="sw-skill__num" aria-hidden="true">
                {skill.number}
              </span>
              <h3 class="sw-skill__title">{skill.title}</h3>
              <p class="sw-skill__detail">
                <strong>{skill.lead}</strong>
                {skill.rest}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sw-section" aria-labelledby="testimonials-heading">
    <div class="sw-shell">
      <div class="sw-grid">
        <div class="sw-c1-3">
          <span class="sw-section__num">{testimonials.number}</span>
          <h2 class="sw-section__title" id="testimonials-heading">{testimonials.heading}</h2>
        </div>
      </div>
      <ul class="sw-quotes">
        {
          testimonials.items.map((item) => (
            <li>
              <figure class="sw-quote">
                <blockquote class="sw-quote__text">{item.quote}</blockquote>
                <figcaption class="sw-quote__cite">
                  <strong>{item.name}</strong>
                  {item.role}, {item.company}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sw-section sw-section--flush" aria-labelledby="writing-heading">
    <div class="sw-shell">
      <div class="sw-grid">
        <div class="sw-c1-3">
          <span class="sw-section__num">{writing.number}</span>
          <h2 class="sw-section__title" id="writing-heading">
            {writing.heading}
            <span>{writing.kicker}</span>
          </h2>
        </div>
        <div class="sw-c10-3" style="display: flex; align-items: flex-start; justify-content: flex-end">
          <a class="sw-textlink" href={writing.cta.href}>
            {writing.cta.label}
            <span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
      <ul class="sw-posts" style="margin-top: 2rem">
        {recent.map((post) => <li><PostCard post={post} /></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .sw-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--fg);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 63.999rem) {
    .sw-portrait {
      max-width: 12rem;
      margin-bottom: 0;
    }
  }

  .sw-role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem 0.875rem;
    margin: 0 0 1.375rem;
    padding-bottom: 1.125rem;
    border-bottom: 1px solid var(--hairline);
  }

  .sw-role__title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.028em;
    margin: 0;
  }

  .sw-figure {
    margin: 0;
  }

  .sw-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    filter: grayscale(1);
  }

  .sw-figure figcaption {
    margin-top: 0.625rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
    line-height: 1.4;
  }

  @media (max-width: 63.999rem) {
    .sw-figure img {
      max-width: 18rem;
    }
  }
</style>
