---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ItemCard from '../components/ItemCard.astro';

const resources = await getEntry('resources', 'resources');
if (!resources) throw new Error('src/content/pages/resources.json is missing');
const { groups } = resources.data;
---

<BaseLayout
  title="Resources"
  description="Newsletters, courses, templates and books Joel Polanco recommends for product managers and founders."
>
  <PageHead
    number="02"
    title="Resources"
    lede="The newsletters, courses, templates and books I actually recommend when someone asks."
  >
    <Fragment slot="eyebrow">Worth your time</Fragment>
  </PageHead>

  {
    groups.map((group, index) => (
      <section class={`sw-section${index === groups.length - 1 ? ' sw-section--flush' : ''}`}>
        <div class="sw-shell">
          <div class="sw-grid" style="margin-bottom: 2rem">
            <div class="sw-c1-3">
              <span class="sw-section__num">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="sw-section__title">{group.group}</h2>
            </div>
          </div>
          <ul class={`sw-cards${group.group === 'Books' ? '' : ' sw-cards--two'}`}>
            {group.items.map((item) => (
              <ItemCard
                title={item.title}
                description={item.description}
                href={item.link}
                image={item.image?.local ?? null}
                imageAlt=""
                aspect="4 / 3"
              />
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</BaseLayout>
