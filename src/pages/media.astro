---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ItemCard from '../components/ItemCard.astro';

const media = await getEntry('media', 'media');
if (!media) throw new Error('src/content/pages/media.json is missing');
const { appearances, talkClips } = media.data;

const listed = appearances.filter((item) => item.videoAvailable);
const featured = listed.find((item) => item.featured) ?? listed[0];
const rest = listed.filter((item) => item !== featured);

function hostOf(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}
---

<BaseLayout
  title="Media"
  description="Talks, podcasts, interviews and press featuring Joel Polanco on product management, customer discovery and edge computing."
>
  <PageHead
    number="03"
    title="Media"
    lede="Podcasts, summit talks, roundtables and press. Mostly about customer discovery, edge computing and how products actually get built."
    count={`${appearances.length} appearances · ${talkClips.length} clips`}
  >
    <Fragment slot="eyebrow">Talks and press</Fragment>
  </PageHead>

  <section class="sw-section">
    <div class="sw-shell">
      <div class="sw-grid" style="margin-bottom: 2rem">
        <div class="sw-c1-3">
          <span class="sw-section__num">01</span>
          <h2 class="sw-section__title">
            Appearances
            <span>Press, video and podcast</span>
          </h2>
        </div>
      </div>

      {
        featured && (
          <article class="sw-card sw-featured">
            <div class="sw-grid">
              <div class="sw-card__media sw-featured__media sw-featured__media--portrait sw-c1-6">
                {featured.thumbnail.local ? (
                  <Image
                    src={featured.thumbnail.local}
                    alt=""
                    width={900}
                    height={1164}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 64rem) 100vw, 40vw"
                    loading="eager"
                  />
                ) : (
                  <div class="sw-cover sw-cover--2" aria-hidden="true">
                    <p class="sw-cover__meta">
                      <span>{hostOf(featured.url)}</span>
                    </p>
                    <div>
                      <p class="sw-cover__title">{featured.title}</p>
                      <div class="sw-cover__rule"></div>
                    </div>
                  </div>
                )}
              </div>
              <div class="sw-c7-6 sw-featured__copy">
                <p class="sw-featured__kicker">Featured</p>
                <h3 class="sw-card__title sw-featured__title">
                  <a href={featured.url} rel="noopener noreferrer" target="_blank">
                    {featured.title}
                  </a>
                </h3>
                <p class="sw-card__meta">
                  <span class="sw-card__host">{hostOf(featured.url)}</span>
                  <span aria-hidden="true">&#8599;</span>
                </p>
              </div>
            </div>
          </article>
        )
      }

      <ul class="sw-cards sw-cards--two">
        {
          rest.map((item) => (
            <li class="sw-card">
              <a class="sw-card__media" href={item.url} rel="noopener noreferrer" target="_blank">
                {item.thumbnail.local ? (
                  <Image
                    src={item.thumbnail.local}
                    alt=""
                    width={960}
                    height={540}
                    widths={[480, 960]}
                    sizes="(max-width: 40rem) 100vw, 45vw"
                    loading="lazy"
                  />
                ) : (
                  <div class="sw-cover sw-cover--1" aria-hidden="true">
                    <p class="sw-cover__meta">
                      <span>{hostOf(item.url)}</span>
                    </p>
                    <div>
                      <p class="sw-cover__title">{item.title}</p>
                      <div class="sw-cover__rule"></div>
                    </div>
                  </div>
                )}
              </a>
              <h3 class="sw-card__title">
                <a href={item.url} rel="noopener noreferrer" target="_blank">
                  {item.title}
                </a>
              </h3>
              <p class="sw-card__meta">
                <span class="sw-card__host">{hostOf(item.url)}</span>
                <span aria-hidden="true">&#8599;</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sw-section sw-section--flush">
    <div class="sw-shell">
      <div class="sw-grid" style="margin-bottom: 2rem">
        <div class="sw-c1-3">
          <span class="sw-section__num">02</span>
          <h2 class="sw-section__title">
            Talk clips
            <span>Short excerpts</span>
          </h2>
        </div>
      </div>
      <ul class="sw-cards">
        {
          talkClips.map((clip) => (
            <ItemCard
              title={clip.title}
              description={clip.description}
              href={clip.link}
              image={clip.image?.local ?? null}
              imageAlt=""
              goneLabel="No recording online"
            />
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
